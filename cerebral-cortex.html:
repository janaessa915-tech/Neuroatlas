}

/* ==================================================
   3D VIEWER
================================================== */

.viewer{
    margin-top:60px;
    border:1px solid rgba(255,255,255,.10);
    border-radius:24px;
    overflow:hidden;
    background:#02060b;
    box-shadow:0 25px 80px rgba(0,0,0,.45);
}

.viewer-header{
    min-height:65px;
    padding:0 22px;
    display:flex;
    align-items:center;
    justify-content:space-between;
