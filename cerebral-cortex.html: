    color:#d2dce6;
}

.viewer-status{
    color:#708499;
    font-size:11px;
    letter-spacing:1px;
}

.scene{
    position:relative;
    width:100%;
    height:700px;

    background:
    radial-gradient(
        circle at 50% 45%,
        #203b51 0%,
        #0d1c2e 42%,
        #02060b 100%
    );
}

#brainCanvas{
    width:100%;
    height:100%;
    display:block;
}

/* ==================================================
   LOADING
================================================== */

.loading{
    position:absolute;
    inset:0;
    z-index:20;

    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;

    gap:16px;

    background:#02060b;

    color:#9db0c3;
    font-size:14px;

    transition:opacity .8s;
}

.loading.hide{
    opacity:0;
    pointer-events:none;
}

.loading-bar{
    width:180px;
    height:2px;

    background:rgba(255,255,255,.08);

    border-radius:2px;
    overflow:hidden;
}

.loading-bar-inner{
    width:0%;
    height:100%;

    background:#ffffff;

    transition:width .3s;
}

/* ==================================================
   CORTEX LABEL
================================================== */

.cortex-label{
    position:absolute;

    z-index:30;

    pointer-events:none;

    transform:translate(-50%,-100%);

    display:none;
}

.cortex-label.show{
    display:block;
}

.label-box{
    position:relative;

    padding:9px 15px;

    border-radius:10px;

    background:rgba(5,10,17,.96);

    border:1.5px solid #ffffff;

    color:#ffffff;

    font-size:12px;

    font-weight:bold;

    letter-spacing:1px;

    white-space:nowrap;

    box-shadow:
        0 0 12px rgba(255,255,255,.25),
        0 0 30px rgba(255,255,255,.10);
}

.label-box::after{
    content:"";

    position:absolute;

    left:50%;
    bottom:-15px;

    width:1.5px;
    height:15px;

    background:#ffffff;

    transform:translateX(-50%);
}

/* ==================================================
   CONTROLS
================================================== */

.controls{
    display:flex;
    gap:10px;
    flex-wrap:wrap;

    padding:15px;

    border-top:1px solid rgba(255,255,255,.08);
}

.controls button{
    padding:11px 17px;

    border-radius:9px;

    background:#0b1928;

    border:1px solid #31516d;

    color:#bdd0e0;

    cursor:pointer;

    transition:.2s;
}

.controls button:hover{
    background:#14304a;
    color:white;
}

.controls button.active{
