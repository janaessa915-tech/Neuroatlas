<!-- ==================================================
     THREE.JS
================================================== -->

<script type="module">

import * as THREE from "three";

import {
    OrbitControls
} from "three/addons/controls/OrbitControls.js";

import {
    GLTFLoader
} from "three/addons/loaders/GLTFLoader.js";

import {
    DRACOLoader
} from "three/addons/loaders/DRACOLoader.js";


/* ==================================================
   ELEMENTS
================================================== */

const canvas =
document.getElementById("brainCanvas");

const loading =
document.getElementById("loading");

const loadText =
document.getElementById("loadText");

const loadBar =
document.getElementById("loadBar");

const cortexLabel =
document.getElementById("cortexLabel");


/* ==================================================
   SCENE
================================================== */

const scene =
new THREE.Scene();


/* ==================================================
   CAMERA
================================================== */

const camera =
new THREE.PerspectiveCamera(
    30,
    1,
    0.01,
    100
);

camera.position.set(
    3.2,
    0.3,
    8.5
);


/* ==================================================
   RENDERER
================================================== */

const renderer =
new THREE.WebGLRenderer({

    canvas:canvas,

    antialias:true,

    alpha:true

});

renderer.setPixelRatio(
    Math.min(
        window.devicePixelRatio || 1,
        2
    )
);

renderer.toneMapping =
THREE.ACESFilmicToneMapping;

renderer.toneMappingExposure =
0.75;


/* ==================================================
   CONTROLS
================================================== */

const controls =
new OrbitControls(
    camera,
    canvas
);

controls.enableRotate = true;

controls.rotateSpeed = 0.6;

controls.enableDamping = true;

controls.dampingFactor = 0.05;

controls.enableZoom = true;

controls.zoomSpeed = 0.6;

controls.enablePan = false;

controls.autoRotate = true;

controls.autoRotateSpeed = 0.2;

controls.target.set(
    0,
    -0.3,
    0
);

controls.minDistance = 3.5;

controls.maxDistance = 16;


/* ==================================================
   LIGHTING
================================================== */

const ambient =
new THREE.AmbientLight(
    0xffffff,
    0.55
);

scene.add(ambient);


const hemi =
new THREE.HemisphereLight(
    0xffffff,
    0x081018,
    0.75
);

scene.add(hemi);


const keyLight =
new THREE.DirectionalLight(
    0xffffff,
    1.4
);

keyLight.position.set(
    6,
    10,
    8
);

scene.add(keyLight);


const fillLight =
new THREE.DirectionalLight(
    0x8ca9bd,
    0.4
);

fillLight.position.set(
    -7,
    2,
    6
);

scene.add(fillLight);


/* ==================================================
   BRAIN GROUP
================================================== */

const brainGroup =
new THREE.Group();

scene.add(brainGroup);


let cortexMesh = null;

let cortexHighlightMesh = null;

let cortexOutline = null;

let highlighted = true;


/* ==================================================
   NORMAL BRAIN MATERIAL
================================================== */

const brainMaterial =
new THREE.MeshPhysicalMaterial({

    color:0xf1c5d0,

    roughness:0.62,

    metalness:0,

    clearcoat:0.12,

    clearcoatRoughness:0.5,

    side:THREE.DoubleSide

});


/* ==================================================
   WHITE CORTEX HIGHLIGHT
================================================== */

const cortexWhiteMaterial =
new THREE.MeshPhysicalMaterial({

    color:0xffffff,

    roughness:0.32,

    metalness:0.02,

    clearcoat:0.35,

    clearcoatRoughness:0.25,

    side:THREE.DoubleSide

});


/* ==================================================
   WHITE OUTLINE
================================================== */

const outlineMaterial =
new THREE.MeshBasicMaterial({

    color:0xffffff,

    transparent:true,

    opacity:0.9,

    side:THREE.BackSide

});


/* ==================================================
   FALLBACK CORTEX
================================================== */

function createCortexMarker(){

    const geometry =
    new THREE.SphereGeometry(
        1.15,
        48,
        32
    );


    cortexHighlightMesh =
    new THREE.Mesh(
        geometry,
        cortexWhiteMaterial
    );


    /*
       This fallback creates a shell-like
       visual marker around the outer brain.
    */

    cortexHighlightMesh.scale.set(
        1.55,
        1.08,
        1.18
    );


    cortexHighlightMesh.position.set(
        0,
        0,
        0
    );


    brainGroup.add(
        cortexHighlightMesh
    );


    cortexOutline =
    new THREE.Mesh(
        geometry.clone(),
        outlineMaterial
    );


    cortexOutline.scale.set(
        1.60,
        1.12,
        1.22
    );


    cortexHighlightMesh.add(
        cortexOutline
    );

}


/* ==================================================
   LOAD REAL BRAIN
================================================== */

function loadRealBrain(){

    const loader =
    new GLTFLoader();


    const dracoLoader =
    new DRACOLoader();


    dracoLoader.setDecoderPath(
        "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/libs/draco/"
    );


    loader.setDRACOLoader(
        dracoLoader
    );


    const urls = [

        "https://cdn.jsdelivr.net/gh/itayinbarr/brainproject@main/brain-atlas/models/brain.glb",

        "https://raw.githubusercontent.com/itayinbarr/brainproject/main/brain-atlas/models/brain.glb",

        "https://itayinbarr.github.io/brainproject/models/brain.glb"

    ];


    let urlIndex = 0;


    function tryLoad(){

        if(
            urlIndex >= urls.length
        ){

            createCortexMarker();

            onReady();

            return;

        }


        const url =
        urls[urlIndex++];


        loadText.textContent =
        "Loading real brain model...";


        loader.load(

            url,


            function(gltf){

                const model =
                gltf.scene;


                /* =================================
                   CENTER + SCALE
                ================================= */

                const box =
                new THREE.Box3()
                .setFromObject(model);


                const center =
                box.getCenter(
                    new THREE.Vector3()
                );


                const size =
                box.getSize(
                    new THREE.Vector3()
                );


                const maxDim =
                Math.max(
                    size.x,
                    size.y,
                    size.z
                );


                const scale =
                4.5 / maxDim;


                model.scale.setScalar(
                    scale
                );


                model.position.sub(
                    center.multiplyScalar(
                        scale
                    )
                );


                model.position.y -= 0.60;


                /* =================================
                   PROCESS MODEL
                ================================= */

                model.traverse(
                function(child){

                    if(
                        !child.isMesh
                    )
                        return;


                    child.castShadow = true;

                    child.receiveShadow = true;


                    const name =
                    (
                        child.name || ""
                    ).toLowerCase();


                    /*
                       =================================
                       CEREBRAL CORTEX DETECTION
                       =================================
                    */

                    if(

                        name.includes("cortex") ||

                        name.includes("cerebrum") ||

                        name.includes("cerebral") ||

                        name.includes("hemisphere") ||

                        name.includes("brain") ||

                        name.includes("cerebralhemisphere")

                    ){

                        /*
                           Don't immediately assume
                           every brain mesh is cortex if
                           it appears to be a separate
                           internal structure.
                        */

                        if(
                            !cortexMesh &&
                            (
                                name.includes("cortex") ||
                                name.includes("cerebrum") ||
                                name.includes("cerebral") ||
                                name.includes("hemisphere")
                            )
                        ){

                            cortexMesh =
                            child;


                            /* =========================
                               WHITE HIGHLIGHT
                            ========================= */

                            cortexHighlightMesh =
                            child.clone();


                            cortexHighlightMesh.material =
                            cortexWhiteMaterial.clone();


                            cortexHighlightMesh.scale.multiplyScalar(
                                1.012
                            );


                            child.parent.add(
                                cortexHighlightMesh
                            );


                            /* =========================
                               WHITE OUTLINE
                            ========================= */

                            cortexOutline =
                            child.clone();


                            cortexOutline.material =
                            outlineMaterial.clone();


                            cortexOutline.scale.multiplyScalar(
                                1.055
                            );


                            child.parent.add(
                                cortexOutline
                            );

                        }

                        else{

                            if(
                                child.material
                            ){

                                child.material =
                                brainMaterial.clone();

                            }

                        }

                    }

                    else{

                        /*
                           Everything else stays
                           normal brain color.
                        */

                        if(
                            child.material
                        ){

                            child.material =
                            brainMaterial.clone();

                        }

                    }

                });


                brainGroup.add(
                    model
                );


                /*
                   If the GLB doesn't expose
                   a cortex mesh, use fallback.
                */

                if(
                    !cortexMesh
                ){

                    createCortexMarker();

                }


                loadBar.style.width =
                "100%";


                onReady();

            },


            function(progress){

                if(
                    progress.total > 0
                ){

                    const pct =
                    Math.min(
                        90,
                        progress.loaded /
                        progress.total *
                        90
                    );


                    loadBar.style.width =
                    pct + "%";

                }

            },


            function(error){

                console.warn(
                    "Model failed:",
                    error
                );


                tryLoad();

            }

        );

    }


    tryLoad();

}


/* ==================================================
   READY
================================================== */

function onReady(){

    setTimeout(
    function(){

        loading.classList.add(
            "hide"
        );


        if(
            highlighted
        ){

            cortexLabel.classList.add(
                "show"
            );

        }

    },500);

}


/* ==================================================
   LABEL POSITION
================================================== */

function updateLabel(){

    if(
        !cortexHighlightMesh
    )
        return;


    const position =
    new THREE.Vector3();


    cortexHighlightMesh
    .getWorldPosition(
        position
    );


    position.project(
        camera
    );


    const x =
    (position.x + 1) /
    2 *
    canvas.clientWidth;


    const y =
    (-position.y + 1) /
    2 *
    canvas.clientHeight;


    cortexLabel.style.left =
    x + "px";


    cortexLabel.style.top =
    (y - 80) + "px";

}


/* ==================================================
   RESIZE
================================================== */

function resize(){

    const width =
    canvas.clientWidth;


    const height =
    canvas.clientHeight;


    if(
        width <= 0 ||
        height <= 0
    )
        return;


    camera.aspect =
    width / height;


    camera.updateProjectionMatrix();


    renderer.setSize(
        width,
        height,
        false
    );

}


window.addEventListener(
    "resize",
    resize
);


/* ==================================================
   HIGHLIGHT BUTTON
================================================== */

const highlightBtn =
document.getElementById(
    "highlight"
);


highlightBtn.addEventListener(
"click",
function(){

    highlighted =
    !highlighted;


    if(
        cortexHighlightMesh
    ){

        cortexHighlightMesh.visible =
        highlighted;

    }


    if(
        cortexOutline
    ){

        cortexOutline.visible =
        highlighted;

    }


    cortexLabel.classList.toggle(
        "show",
        highlighted
    );


    highlightBtn.classList.toggle(
        "active",
        highlighted
    );


    highlightBtn.textContent =

    highlighted

    ? "⚪ Highlight Cortex"

    : "⚫ Show Cortex";

});


/* ==================================================
   AUTO ROTATE
================================================== */

const rotateBtn =
document.getElementById(
    "rotate"
);


rotateBtn.addEventListener(
"click",
function(){

    controls.autoRotate =
    !controls.autoRotate;


    rotateBtn.classList.toggle(
        "active",
        controls.autoRotate
    );


    rotateBtn.textContent =

    controls.autoRotate

    ? "⟳ Auto Rotate"

    : "▶ Auto Rotate";

});


/* ==================================================
   RESET
================================================== */

document.getElementById(
    "reset"
).addEventListener(
"click",
function(){

    camera.position.set(
        3.2,
        0.3,
        8.5
    );


    controls.target.set(
        0,
        -0.3,
        0
    );


    controls.update();

});


/* ==================================================
   ANIMATION
================================================== */

function animate(){

    requestAnimationFrame(
        animate
    );


    controls.update();


    updateLabel();


    renderer.render(
        scene,
        camera
    );

}


/* ==================================================
   START
================================================== */

resize();

animate();

loadRealBrain();


/* ==================================================
   LOCATION BUTTON
================================================== */

const locationButton =
document.getElementById(
    "locationButton"
);

const locationVisual =
document.getElementById(
    "locationVisual"
);


locationButton.addEventListener(
"click",
function(){

    setTimeout(
    function(){

        locationVisual.classList.add(
            "show"
        );

    },50);

});


/* ==================================================
   QUIZ
================================================== */

let score = 0;

let answered = 0;

const questionBlocks =
document.querySelectorAll(
    ".question-block"
);


questionBlocks.forEach(
function(question){

    const correctAnswer =
    question.dataset.answer;

    const options =
    question.querySelectorAll(
        ".option"
    );

    const feedback =
    question.querySelector(
        ".question-feedback"
    );


    let alreadyAnswered =
    false;


    options.forEach(
    function(option){

        option.addEventListener(
        "click",
        function(){

            if(
                alreadyAnswered
            )
                return;


            alreadyAnswered =
            true;


            const selected =
            option.dataset.option;


            options.forEach(
            function(btn){

                btn.disabled =
                true;

            });


            if(
                selected === correctAnswer
            ){

                score++;

                option.classList.add(
                    "correct"
                );


                feedback.textContent =
                "✓ Correct! · إجابة صحيحة";

                feedback.style.color =
                "#78e0a0";

            }

            else{

                option.classList.add(
                    "wrong"
                );


                options.forEach(
                function(btn){

                    if(
                        btn.dataset.option ===
                        correctAnswer
                    ){

                        btn.classList.add(
                            "correct"
                        );

                    }

                });


                feedback.textContent =
                "✗ Incorrect. The correct answer is highlighted. · إجابة غير صحيحة، الإجابة الصحيحة موضحة بالأعلى.";

                feedback.style.color =
                "#ff8792";

            }


            answered++;


            if(
                answered ===
                questionBlocks.length
            ){

                showFinalScore();

            }

        });

    });

});


/* ==================================================
   FINAL QUIZ SCORE
================================================== */

function showFinalScore(){

    const result =
    document.getElementById(
        "quizResult"
    );


    let message = "";


    if(
        score === 3
    ){

        message =
        "🔥 Perfect! Excellent work! · ممتاز! إجاباتك كلها صحيحة!";

    }

    else if(
        score === 2
    ){

        message =
        "👏 Great job! Just one more to master it. · شغل ممتاز! باقي إجابة واحدة فقط.";

    }

    else if(
        score === 1
    ){

        message =
        "💡 Good start! Review the anatomy and try again. · بداية جيدة! راجعي التشريح وجربي مرة أخرى.";

    }

    else{

        message =
        "🧠 Keep learning! Review the cortex sections and try again. · كملي تعلم! راجعي أقسام القشرة المخية وجربي مرة أخرى.";

    }


    result.innerHTML =

    "<strong>" +
    message +
    "</strong>" +

    "<br><br>" +

    "Final Score · النتيجة النهائية: " +

    score +

    " / 3";

}

</script>


